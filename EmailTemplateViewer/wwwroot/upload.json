  "Notification.Engine.TemplateHtmlContent.company-email": "<!DOCTYPE html>\r\n<html lang=\"en\">\r\n<head>\r\n    <meta charset=\"UTF-8\">\r\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\r\n    <title>Professional Email Template</title>\r\n    <style>\r\n        /* Reset styles for email compatibility */\r\n        body {\r\n            margin: 0;\r\n            padding: 0;\r\n            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;\r\n            background-color: #f6f9fc;\r\n            -webkit-font-smoothing: antialiased;\r\n            -moz-osx-font-smoothing: grayscale;\r\n        }\r\n\r\n        /* Main container */\r\n        .email-wrapper {\r\n            width: 100%;\r\n            background-color: #f6f9fc;\r\n            padding: 40px 0;\r\n        }\r\n\r\n        .email-container {\r\n            max-width: 600px;\r\n            margin: 0 auto;\r\n            background-color: #ffffff;\r\n            border-radius: 12px;\r\n            overflow: hidden;\r\n            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\r\n        }\r\n\r\n        /* Header styles */\r\n        .email-header {\r\n            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);\r\n            padding: 50px 40px;\r\n            text-align: center;\r\n            color: #ffffff;\r\n        }\r\n\r\n        .email-header .logo {\r\n            font-size: 32px;\r\n            font-weight: 700;\r\n            margin-bottom: 10px;\r\n            letter-spacing: -0.5px;\r\n        }\r\n\r\n        .email-header .tagline {\r\n            font-size: 16px;\r\n            opacity: 0.9;\r\n            margin: 0;\r\n        }\r\n\r\n        /* Content styles */\r\n        .email-content {\r\n            padding: 50px 40px;\r\n        }\r\n\r\n        .email-content h1 {\r\n            color: #1a1a1a;\r\n            font-size: 28px;\r\n            font-weight: 700;\r\n            margin: 0 0 20px 0;\r\n            line-height: 1.3;\r\n        }\r\n\r\n        .email-content h2 {\r\n            color: #333333;\r\n            font-size: 22px;\r\n            font-weight: 600;\r\n            margin: 30px 0 15px 0;\r\n        }\r\n\r\n        .email-content p {\r\n            color: #666666;\r\n            line-height: 1.7;\r\n            font-size: 16px;\r\n            margin: 0 0 16px 0;\r\n        }\r\n\r\n        .greeting {\r\n            font-size: 18px;\r\n            color: #333333;\r\n            margin-bottom: 20px;\r\n        }\r\n\r\n        /* Button styles */\r\n        .button-container {\r\n            text-align: center;\r\n            margin: 35px 0;\r\n        }\r\n\r\n        .button {\r\n            display: inline-block;\r\n            padding: 16px 40px;\r\n            background-color: #667eea;\r\n            color: #ffffff !important;\r\n            text-decoration: none;\r\n            border-radius: 8px;\r\n            font-weight: 600;\r\n            font-size: 16px;\r\n            transition: all 0.3s ease;\r\n            box-shadow: 0 4px 12px rgba(102, 126, 234, 0.3);\r\n        }\r\n\r\n        .button:hover {\r\n            background-color: #5568d3;\r\n            transform: translateY(-2px);\r\n            box-shadow: 0 6px 16px rgba(102, 126, 234, 0.4);\r\n        }\r\n\r\n        .button-secondary {\r\n            background-color: #ffffff;\r\n            color: #667eea !important;\r\n            border: 2px solid #667eea;\r\n            box-shadow: none;\r\n        }\r\n\r\n        .button-secondary:hover {\r\n            background-color: #f6f9fc;\r\n            transform: translateY(-2px);\r\n        }\r\n\r\n        /* Info box styles */\r\n        .info-box {\r\n            background-color: #f6f9fc;\r\n            border-left: 4px solid #667eea;\r\n            padding: 20px;\r\n            margin: 25px 0;\r\n            border-radius: 4px;\r\n        }\r\n\r\n        .info-box p {\r\n            margin: 0;\r\n  