         background-color: #f6f9fc;\r\n            padding: 40px;\r\n            text-align: center;\r\n        }\r\n\r\n        .social-links {\r\n            margin: 25px 0;\r\n        }\r\n\r\n        .social-links a {\r\n            display: inline-block;\r\n            margin: 0 12px;\r\n            padding: 10px 18px;\r\n            background-color: #ffffff;\r\n            color: #667eea;\r\n            text-decoration: none;\r\n            border-radius: 6px;\r\n            font-size: 14px;\r\n            font-weight: 600;\r\n            transition: all 0.3s ease;\r\n        }\r\n\r\n        .social-links a:hover {\r\n            background-color: #667eea;\r\n            color: #ffffff;\r\n        }\r\n\r\n        .footer-text {\r\n            color: #999999;\r\n            font-size: 14px;\r\n            line-height: 1.6;\r\n            margin: 10px 0;\r\n        }\r\n\r\n        .footer-links {\r\n            margin: 20px 0 10px 0;\r\n        }\r\n\r\n        .footer-links a {\r\n            color: #667eea;\r\n            text-decoration: none;\r\n            margin: 0 10px;\r\n            font-size: 14px;\r\n        }\r\n\r\n        .footer-links a:hover {\r\n            text-decoration: underline;\r\n        }\r\n\r\n        /* Table styles for data display */\r\n        .data-table {\r\n            width: 100%;\r\n            border-collapse: collapse;\r\n            margin: 25px 0;\r\n        }\r\n\r\n        .data-table th {\r\n            background-color: #f6f9fc;\r\n            color: #333333;\r\n            font-weight: 600;\r\n            padding: 15px;\r\n            text-align: left;\r\n            border-bottom: 2px solid #667eea;\r\n        }\r\n\r\n        .data-table td {\r\n            padding: 15px;\r\n            border-bottom: 1px solid #eeeeee;\r\n            color: #666666;\r\n        }\r\n\r\n        .data-table tr:last-child td {\r\n            border-bottom: none;\r\n        }\r\n\r\n        /* Responsive design */\r\n        @medi