@page "/"
@rendermode InteractiveServer
@inject IJSRuntime JSRuntime

<PageTitle>Email Template Viewer</PageTitle>

<div class="viewer-container">
    <Splitter Orientation="Orientation.Horizontal">
        <SplitterSection Size="50">
            <div class="input-section">
                <h2>Email Template Viewer</h2>
                <p class="subtitle">Paste your SendGrid HTML template below to preview it</p>
                
                <textarea 
                    class="html-input" 
                    @bind="htmlContent" 
                    placeholder="Paste your HTML email template here..."
                    rows="20"></textarea>
                
                <div class="action-buttons">
                    <button class="btn-preview" @onclick="UpdatePreview">Update Preview</button>
                    <button class="btn-convert" @onclick="ToggleConversionDialog">Generate JSON</button>
                </div>

                @if (showConversionDialog)
                {
                    <div class="conversion-dialog">
                        <div class="dialog-header">
                            <h4>Generate JSON File</h4>
                        </div>
                        <div class="dialog-body">
                            <label for="templateName">Template Name:</label>
                            <input 
                                type="text" 
                                id="templateName"
                                class="template-name-input" 
                                @bind="templateName" 
                                placeholder="Enter template name (e.g., welcome-email)" />
                            <p class="help-text">The JSON key will be: <code>Notification.Engine.TemplateHtmlContent.@(string.IsNullOrWhiteSpace(templateName) ? "{template-name}" : templateName)</code></p>
                            
                            @if (!string.IsNullOrWhiteSpace(conversionMessage))
                            {
                                <div class="@(conversionSuccess ? "success-message" : "error-message")">
                                    @conversionMessage
                                </div>
                            }
                        </div>
                        <div class="dialog-footer">
                            <button class="btn-secondary" @onclick="ToggleConversionDialog">Cancel</button>
                            <button class="btn-primary" @onclick="GenerateAndDownloadJson" disabled="@string.IsNullOrWhiteSpace(htmlContent)">Generate & Download</button>
                        </div>
                    </div>
                }
            </div>
        </SplitterSection>

        <SplitterSection Size="50">
            <div class="preview-section">
        <div class="preview-header">
            <h3>Preview</h3>
            <div class="view-switcher">
                <button class="@GetViewButtonClass("mobile")" 
                        @onclick="SwitchToMobile">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect>
                        <line x1="12" y1="18" x2="12.01" y2="18"></line>
                    </svg>
                    Mobile
                </button>
                <button class="@GetViewButtonClass("desktop")" 
                        @onclick="SwitchToDesktop">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
                        <line x1="8" y1="21" x2="16" y2="21"></line>
                        <line x1="12" y1="17" x2="12" y2="21"></line>
                    </svg>
                    Desktop
                </button>
            </div>
        </div>
        <div class="preview-container">
            @if (viewMode == "desktop")
            {
                <div class="preview-frame desktop-view">
                    <div class="frame-header">
                        <span class="frame-title">Desktop View</span>
                        <span class="frame-dimensions">1200px</span>
                    </div>
                    <iframe srcdoc="@previewContent" class="preview-iframe desktop"></iframe>
                </div>
            }
            
            @if (viewMode == "mobile")
            {
                <div class="preview-frame mobile-view">
                    <div class="frame-header">
                        <span class="frame-title">Mobile View</span>
                        <span class="frame-dimensions">375px</span>
                    </div>
                    <iframe srcdoc="@previewContent" class="preview-iframe mobile"></iframe>
                </div>
            }
        </div>
            </div>
        </SplitterSection>
    </Splitter>
</div>

@code {
    private string htmlContent = "";
    private string previewContent = "<html><body style='display: flex; align-items: center; justify-content: center; height: 100vh; font-family: sans-serif; color: #666;'><p>Paste your HTML template and click 'Update Preview' to see the preview here</p></body></html>";
    private string viewMode = "mobile"; // Default to mobile view
    private bool showConversionDialog = false;
    private string templateName = "";
    private string conversionMessage = "";
    private bool conversionSuccess = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var sampleEmailPath = Path.Combine(Directory.GetCurrentDirectory(), "sample-email.html");
            if (File.Exists(sampleEmailPath))
            {
                htmlContent = await File.ReadAllTextAsync(sampleEmailPath);
                previewContent = htmlContent;
            }
        }
        catch { }
    }

    private string GetViewButtonClass(string mode)
    {
        return viewMode == mode ? "view-btn active" : "view-btn";
    }

    private void SwitchToMobile()
    {
        viewMode = "mobile";
    }

    private void SwitchToDesktop()
    {
        viewMode = "desktop";
    }

    private void UpdatePreview()
    {
        if (!string.IsNullOrWhiteSpace(htmlContent))
        {
            previewContent = htmlContent;
        }
        else
        {
            previewContent = "<html><body style='display: flex; align-items: center; justify-content: center; height: 100vh; font-family: sans-serif; color: #666;'><p>No content to preview</p></body></html>";
        }
    }

    private void ToggleConversionDialog()
    {
        showConversionDialog = !showConversionDialog;
        if (!showConversionDialog)
        {
            conversionMessage = "";
            templateName = "";
        }
    }

    private async Task GenerateAndDownloadJson()
    {
        try
        {
            if (string.IsNullOrWhiteSpace(htmlContent))
            {
                conversionMessage = "Please enter HTML content first.";
                conversionSuccess = false;
                return;
            }

            if (string.IsNullOrWhiteSpace(templateName))
            {
                conversionMessage = "Please enter a template name.";
                conversionSuccess = false;
                return;
            }

            // Create the JSON term key (same logic as EmailJsonConverter)
            var term = $"Notification.Engine.TemplateHtmlContent.{templateName.Trim()}";

            // Create JSON object
            var jsonFlat = new Newtonsoft.Json.Linq.JObject();
            jsonFlat.Add(term, htmlContent);

            // Serialize to JSON with proper formatting
            var json = Newtonsoft.Json.JsonConvert.SerializeObject(jsonFlat, Newtonsoft.Json.Formatting.Indented);

            // Generate filename
            var fileName = $"{templateName.Trim()}.json";

            // Download the file using JavaScript interop
            await JSRuntime.InvokeVoidAsync("downloadFile", fileName, json, "application/json");

            conversionMessage = $"✓ Successfully generated '{fileName}'";
            conversionSuccess = true;

            // Auto-close dialog after 2 seconds
            await Task.Delay(2000);
            ToggleConversionDialog();
        }
        catch (Exception ex)
        {
            conversionMessage = $"✗ Error: {ex.Message}";
            conversionSuccess = false;
        }
    }
}